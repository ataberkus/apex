{
  "name": "@apex-agent/pi",
  "version": "0.0.0",
  "description": "Apex: pinned Pi launcher, offline evals, and opt-in context, reliability and daily-driver extensions",
  "type": "module",
  "private": true,
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "bin": {
    "apex": "bin/apex"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "pi": {
    "extensions": [
      "./extensions/apex-context/index.mjs",
      "./extensions/apex-core/index.mjs",
      "./extensions/apex-features/index.mjs"
    ],
    "skills": [],
    "prompts": [],
    "themes": []
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "jsdom": "21.1.2"
  },
  "scripts": {
    "check": "bun scripts/check.mjs",
    "check:windows": "bun scripts/check.mjs --windows",
    "test": "bun scripts/test.mjs",
    "test:windows": "bun scripts/test.mjs --windows",
    "micro": "bun scripts/micro.mjs",
    "micro:windows": "bun scripts/micro-windows.mjs",
    "preflight": "bun scripts/preflight.mjs --json",
    "preflight:windows": "bun scripts/preflight-windows.mjs --json",
    "smoke:windows-package": "bun scripts/smoke-windows-package.mjs",
    "build:installer": "bun scripts/build-installer.mjs",
    "apex": "bun bin/apex",
    "dashboard": "bun dashboard/server.mjs --open",
    "evolve": "bun scripts/evolve.mjs",
    "micro:evolve": "bun scripts/evolve.mjs --micro"
  },
  "files": [
    ".gitattributes",
    "bin/apex",
    "dashboard",
    "lib",
    "scripts/*.mjs",
    "scripts/*.py",
    "scripts/*.sh",
    "evals/**/*.py",
    "evals/**/*.mjs",
    "evals/**/*.json",
    "evolve/*.py",
    "evolve/*.mjs",
    "evolve/config.json",
    "evolve/README.md",
    "evolve/leaderboard.md",
    "tests/*.py",
    "tests/*.test.mjs",
    "tests/fixtures/*.mjs",
    "prompts",
    "extensions",
    "skills",
    "templates",
    "research/*.md",
    "research/*.json",
    "validation/harbor-run-help.txt",
    "validation/harbor-datasets.txt",
    "validation/harbor-datasets-legacy.txt",
    "validation/offline-micro.json",
    "validation/process-micro.json",
    "validation/local-preflight.json",
    "validation/fd-dependency.json",
    "validation/build-verification.json",
    "validation/openrouter-auth-check.json",
    "APEX_BUILD.md",
    "PHASE0_PLAN.md",
    "PROGRESS.md",
    "NOTES.md",
    "DECISIONS.md",
    "RESULTS.md",
    "README.md",
    "SETUP_FREE.md",
    "WINDOWS_LOCAL.md",
    "validation/windows-*.json",
    "LICENSE",
    "PHASE0_LOCAL.md",
    "validation/session-micro.json",
    "validation/pipeline-micro.json",
    "validation/phase0-local.json",
    "PHASE1_DESIGN.md",
    "PHASE1_PLAN.md",
    "PHASE1_LOCAL.md",
    "validation/phase1-local.json",
    "validation/phase1-micro.json",
    "validation/phase1-*-report.md",
    "validation/phase1-unit.log",
    "validation/phase1-micro-gates.log",
    "validation/phase1-cleanup.json",
    "validation/phase1-final-review.md",
    "validation/phase1-check.log",
    "PHASE2_DESIGN.md",
    "PHASE2_PLAN.md",
    "PHASE2_LOCAL.md",
    "validation/phase2-*.json",
    "validation/phase2-*.md",
    "validation/phase2-*.log",
    "PHASE3_DESIGN.md",
    "PHASE3_PLAN.md",
    "PHASE3_LOCAL.md",
    "validation/phase3-*.json",
    "validation/phase3-*.md",
    "validation/phase3-*.log",
    "validation/phase4-*.json",
    "validation/phase4-*.log"
  ],
  "dependencies": {
    "@oh-my-pi/pi-ai": "18.9.1",
    "@oh-my-pi/pi-natives": "18.9.1",
    "marked": "18.0.11",
    "playwright-core": "1.64.1"
  }
}
